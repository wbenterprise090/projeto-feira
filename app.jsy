const express = require('express');
const router = express.Router();
const dotenv = require('dotenv');
dotenv.config();

const GEMINI_API_KEY = process.env.GEMINI_API_KEY;

router.post('/processar', async (req, res) => {
  try {
    const { nome, idade, cursoDesejado, perguntaAberta, notas, respostas, transicao } = req.body;

    const prompt = `Tu és IA Maria, orientadora vocacional profissional. Seja OBJETIVO.

DADOS DO ALUNO:
Nome: ${nome}
Idade: ${idade}
Transição: ${transicao} // secundario_medio ou medio_faculdade
Curso desejado: ${cursoDesejado}
Motivo: ${perguntaAberta || 'Não informado'}
Notas: ${JSON.stringify(notas)}
Perfil comportamental: ${JSON.stringify(respostas)}

INSTRUÇÕES:
1. Se transicao = "secundario_medio", prioriza cursos técnicos do Instituto Maria Osvalda
2. Se transicao = "medio_faculdade", prioriza cursos universitários e licenciaturas
3. Usa as respostas do quiz pra afinar: logica=TI/Engenharia, criativo=Artes/Design, social=Saúde/Educação, pratico=Construção/Mecânica, dinheiro=Negócios
4. Retorna EXATAMENTE 3 áreas profissionais
5. Compatibilidade = número inteiro 75-98 baseado em notas + perfil
6. Justificativa = 1 frase curta baseada nas notas + respostas

FORMATO - APENAS JSON VÁLIDO:
[
  {
    "nome": "Tecnologia da Informação",
    "compat": 96,
    "icon": "laptop-code",
    "cor": "#3b82f6",
    "justificativa": "Nota alta em Informática + perfil lógico indicam forte aptidão."
  }
]

Áreas: Tecnologia da Informação, Engenharia, Saúde, Educação, Negócios/Administração, Artes e Design, Desportos
Ícones: laptop-code, cogs, heartbeat, chalkboard-teacher, briefcase, palette, running
Cores: #3b82f6, #2563eb, #dc2626, #059669, #7c3aed, #db2777, #ea580c

RETORNA SÓ O JSON.`;

    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash-latest:generateContent?key=${GEMINI_API_KEY}`,
      {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
          contents: [{ parts: [{text: prompt}] }],
          generationConfig: {
            temperature: 0.3,
            maxOutputTokens: 800,
            responseMimeType: "application/json"
          }
        })
      }
    );

    if (!response.ok) throw new Error('Erro na API Gemini');

    const data = await response.json();
    const texto = data.candidates[0].content.parts[0].text;
    let resultado = JSON.parse(texto);

    // Adiciona dados de mercado baseados na transição
    const infoMercadoTecnico = {
      "Tecnologia da Informação": { salario: "60.000 - 150.000 KZ", demanda: "Muito Alta", cursos: "Técnico de Informática, Redes" },
      "Engenharia": { salario: "80.000 - 200.000 KZ", demanda: "Alta", cursos: "Técnico de Construção, Mecânica" },
      "Saúde": { salario: "70.000 - 180.000 KZ", demanda: "Alta", cursos: "Técnico de Enfermagem" },
      "Educação": { salario: "50.000 - 120.000 KZ", demanda: "Média", cursos: "Formação de Professores" },
      "Negócios/Administração": { salario: "60.000 - 140.000 KZ", demanda: "Alta", cursos: "Técnico de Gestão" },
      "Artes e Design": { salario: "45.000 - 100.000 KZ", demanda: "Crescente", cursos: "Técnico de Design" },
      "Desportos": { salario: "40.000 - 90.000 KZ", demanda: "Média", cursos: "Técnico de Desporto" }
    };

    const infoMercadoUniversitario = {
      "Tecnologia da Informação": { salario: "80.000 - 250.000 KZ", demanda: "Muito Alta", cursos: "Eng. Informática, Sistemas" },
      "Engenharia": { salario: "120.000 - 400.000 KZ", demanda: "Alta", cursos: "Eng. Civil, Mecânica, Elétrica" },
      "Saúde": { salario: "100.000 - 300.000 KZ", demanda: "Alta", cursos: "Medicina, Enfermagem, Farmácia" },
      "Educação": { salario: "70.000 - 180.000 KZ", demanda: "Média", cursos: "Pedagogia, Línguas" },
      "Negócios/Administração": { salario: "90.000 - 200.000 KZ", demanda: "Alta", cursos: "Gestão, Economia, Marketing" },
      "Artes e Design": { salario: "60.000 - 150.000 KZ", demanda: "Crescente", cursos: "Design Gráfico, Multimédia" },
      "Desportos": { salario: "50.000 - 120.000 KZ", demanda: "Média", cursos: "Educação Física, Treino" }
    };

    const infoMercado = transicao === 'secundario_medio'? infoMercadoTecnico : infoMercadoUniversitario;

    resultado = resultado.map(area => ({
     ...area,
      mercado: infoMercado[area.nome]
    }));

    res.json({ resultado });

  } catch(error) {
    console.error('Erro Gemini:', error);
    res.status(500).json({ erro: 'Erro ao processar com IA. Tenta novamente.' });
  }
});

router.post('/feedback', (req, res) => {
  console.log('Feedback recebido:', req.body);
  res.json({ sucesso: true });
});

module.exports = router;

