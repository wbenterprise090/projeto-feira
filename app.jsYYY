



        const express = require('express');
const router = express.Router();
const dotenv = require('dotenv');
dotenv.config();

const GEMINI_API_KEY = process.env.GEMINI_API_KEY;

router.post('/processar', async (req, res) => {
  try {
    const { nome, idade, cursoDesejado, perguntaAberta, transicao, notas, respostas } = req.body;

    const prompt = `Tu és IA Maria, orientadora vocacional.
DADOS DO ALUNO:
Nome: ${nome}
Idade: ${idade}
Transicao: ${transicao}
Curso desejado: ${cursoDesejado}
Motivo: ${perguntaAberta || 'Não informado'}
Notas: ${JSON.stringify(notas)}
Perfil comportamental: ${JSON.stringify(respostas)}

INSTRUÇÕES:
1. Se transicao = "secundario_medio", prioriza cursos técnicos
2. Se transicao = "medio_faculdade", prioriza cursos universidade
3. Usa as respostas do quiz pra afinar: logica=TI/Engenharia, criatividade=Design/Artes, social=Educação/Saúde
4. Retorna EXATAMENTE 3 áreas profissionais
5. Compatibilidade = número inteiro 75-98 baseado em notas
6. Justificativa = 1 frase curta baseada nas notas + respostas

FORMATO - APENAS JSON VÁLIDO:
[
  {
    "nome": "Tecnologia da Informação",
    "compat": 96,
    "icon": "laptop-code",
    "cor": "#3b82f6",
    "justificativa": "Nota alta em Informática + perfil lógico"
  }
]

Áreas: Tecnologia da Informação, Engenharia, Saúde, Educação, Design, Administração, Direito, Comunicação
Ícones: laptop-code, cogs, heartbeat, chalkboard-teacher, palette, briefcase, gavel, megaphone
Cores: #3b82f6, #2563eb, #dc2626, #059669, #7c3aed, #db2777, #f59e0b, #ec4899

RETORNA SÓ O JSON.`;

    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_API_KEY}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ parts: [{ text: prompt }]
      })
    });

    const data = await response.json();
    const texto = data.candidates[0].content.parts[0].text;
    
    const jsonLimpo = texto.replace(/```json/g, '').replace(/```/g, '').trim();
    const resultado = JSON.parse(jsonLimpo);

    res.json(resultado);
  } catch (error) {
    console.error(error);
    res.status(500).json({ erro: 'Erro ao processar com a IA Maria' });
  }
});

module.exports = router;
